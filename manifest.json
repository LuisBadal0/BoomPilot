{
  "manifest_version": 2,
  "name": "BoomPilot",
  "version": "1.0.0",
  "author": "Luis Badalo",
  "homepage_url": "https://addons.mozilla.org/firefox/",
  "description": "Control, mute, and boost audio volume per tab with quick presets, a changed-tabs dashboard, and live badge updates.",
  "permissions": [
    "tabs",
    "activeTab",
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "boompilot@luisbadalo.dev",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [],
        "optional": []
      }
    }
  },
  "browser_action": {
    "default_title": "BoomPilot",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon.svg"
  }
}
