{
  "manifest_version": 3,
  "name": "BoomPilot",
  "version": "1.1.3",
  "author": "Luis Badalo",
  "description": "Control, mute, and boost audio volume per tab with quick presets, a changed-tabs dashboard, and live badge updates.",
  "permissions": ["tabs", "activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "browser_specific_settings": {
    "gecko": {
      "id": "boompilot@luisbadalo.dev",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  },
  "action": {
    "default_title": "BoomPilot",
    "default_popup": "popup.html",
    "default_icon": "assets/icon.svg"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "48": "assets/icon.svg"
  }
}
